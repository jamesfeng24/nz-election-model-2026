    "partyWithoutCandidate": "mass_reallocated_by_normalization_as_explicit_model_assumption_not_ballot_identity"
  },
  "fitProposal": {
    "parameter": "kappa",
    "rangeInclusive": [0.0001, 0.1],
    "objective": "equal_contest_mean_cross_entropy_of_earlier_observed_candidate_shares",
    "minimumCompleteGeneralTrainingContests": 20,
    "minimumIndependentOrZeroSupportTrainingContests": 5,
    "boundarySolution": "report_and_do_not_expand_range_after_holdout_results",
    "maori": "abstain_from_separately_fitted_coefficient_without_sufficient_prior_coverage"
  },
  "tasks": {
    "conditionalHistorical": "observed_target_local_party_share_and_retrospective_slate_allowed_only_as_conditional_inputs",
