  "dataClass": "design_contract_not_prediction",
  "recommendedDesign": "direct_party_anchored_candidate_share_composition",
  "estimand": "conditional_share_of_valid_candidate_votes_for_every_standing_candidate",
  "units": {
    "partySupport": "share_of_valid_party_votes_on_target_boundary",
