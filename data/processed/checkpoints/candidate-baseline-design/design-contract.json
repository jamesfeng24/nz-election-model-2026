  "historicalFrame": {
    "coverageContests": 213,
    "conditionalHeldGeneralContests": 191,
    "conditionalHeldGeneralCandidates": 1313,
    "maoriCoverageOnlyContests": 21,
    "cancelledCoverageOnlyContests": 1,
    "holdouts": [2011, 2017, 2023],
    "training": "only completed elections strictly earlier than target; 2008 for 2011, through 2014 for 2017, through 2020 for 2023"
  },
  "benchmarks": {
